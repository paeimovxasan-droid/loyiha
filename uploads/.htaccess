# Block all script execution in uploads directory
Options -ExecCGI
RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .pl .py .rb .cgi
AddType text/plain .php .php3 .php4 .php5 .php7 .php8 .phtml

<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|pl|py|rb|cgi|sh)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>
